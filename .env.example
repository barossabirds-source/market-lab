# Netlify build environment: safe for the browser
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# GitHub Actions secret: server-side only, NEVER expose in Netlify/browser code
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Legacy projects can temporarily use SUPABASE_SERVICE_ROLE_KEY instead.
